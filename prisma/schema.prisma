}

// ── VoiceConversation — Twilio call transcript + extracted data ──────────
model VoiceConversation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Call metadata from Twilio
  callSid         String    @unique
  direction       String
  callerPhone     String
  calledPhone     String
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  recordingUrl    String?
  recordingSid    String?

  // Conversation classification
  conversationType String @default("general")

  // Full transcript - NEVER DELETED OR TRUNCATED
  fullTranscript String @db.Text

  // Extracted structured data (JSON blob)
  extractedData Json?

  // Processing status
  status      String    @default("in_progress")
  extractedAt DateTime?

  // User/contact links — userProfile relation dropped (no UserProfile in
  // Olivia Brain); userId references Clerk user ID directly.
  userId          String?        @db.Uuid
  voiceContactId  String?        @db.Uuid
  voiceContact    VoiceContact?  @relation(fields: [voiceContactId], references: [id], onDelete: SetNull)
  calendarEntryId String?        @db.Uuid
  calendarEntry   CalendarEntry? @relation(fields: [calendarEntryId], references: [id], onDelete: SetNull)

  // Related action items
  actionItems VoiceActionItem[]

  // Olivia memory integration (array of memory IDs for context continuity)
  memoryIds String[] @default([])

  // B2B Package Integration — polymorphic IDs (Document/Package models
  // don't exist in Olivia Brain; preserved as plain strings for forward-
  // compat with cluesintelligence Track L)
  generatedDocumentId String?
  generatedPackageId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([callSid])
  @@index([direction])
  @@index([callerPhone])
  @@index([status])
  @@index([conversationType])
  @@index([userId])
  @@index([voiceContactId])
  @@index([startedAt])
  @@index([generatedDocumentId])
  @@index([generatedPackageId])
  @@map("voice_conversations")
}

// ── VoiceContact — CRM contact derived from voice conversations ──────────
// linkedPersonId dropped (LTM-domain Person model not in Olivia Brain).
model VoiceContact {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  firstName String?
  lastName  String?
  email     String?
  phone     String
  company   String?
  role      String?

  location    String?
  industry    String?
  companySize String?

  needs              String[] @default([])
  interests          String[] @default([])
  goals              String[] @default([])
  painPoints         String[] @default([])
  communicationStyle String?

