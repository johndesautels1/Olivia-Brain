  granted        Boolean   @default(true)
  grantedAt      DateTime  @default(now())
  revokedAt      DateTime?
  ipAddress      String?
  userAgent      String?
  metadata       Json?

  @@unique([userId, consentType])
  @@index([userId])
  @@index([consentType, granted])
  @@map("olivia_consents")
}

/// Layer 2: Admin-Editable Guardrails — content rules, blocked terms,
/// competitor names. Editable via admin UI. Olivia loads these dynamically
/// alongside hardcoded defaults in `lib/calendar/olivia-guardrails.ts`.
model OliviaGuardrail {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String
  value       String
  replacement String?
  severity    String   @default("block")
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  metadata    Json?

  @@unique([category, value])
  @@index([category, isActive])
  @@map("olivia_guardrails")
