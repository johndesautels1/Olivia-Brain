  product_overview
  technical_architecture
  methodology_whitepaper
  financial_model
  pricing_sheet
  licensing_sheet
  proposal
  roadmap
  integration_guide
  sample_report
  term_sheet
  legal_agreement
  diligence_doc
  marketing_doc
}

enum DocAudienceType {
  investor
  strategic_partner
  enterprise_client
  white_label_partner
  acquirer
  reseller
  media
  internal
}

enum PurposeType {
  fundraising
  partnership
  licensing
  pilot
  acquisition
  diligence
  education
  outreach
