  complete
}

/// Origin of a Document. Stored explicitly so the dashboard "My Documents"
/// tile renders source chips without re-deriving from heuristics.
enum DocSourceKind {
  user_upload
  business_library
  general_library
  studio_olivia
  voice_dictation
  authored
}

enum OutreachGoal {
  fundraising
  strategic_partnership
  white_label
  pilot
  reseller
  acquisition
  enterprise_sales
}

enum PackageStatus {
  draft
  ready
  sent
  viewed
  engaged
  closed
  package_archived
}

// ─── Document — LTM-aligned (line 1189 of LTM schema) ──────────────────────

/// Top-level document record. Templates have `isTemplate = true` and
/// `ownerUserId = null`; user-owned copies (via fork or new-doc wizard)
/// have `ownerUserId` set + `sourceTemplateId` pointing back at the
/// template they were forked from.
model Document {
  id                String               @id @default(cuid())
  /// LTM: required FK to `DocumentCollection`. OB: optional, no FK
  /// because OB doesn't have the collection table yet.
  collectionId      String?
  title             String
  slug              String               @unique
  documentType      DocumentType
  audienceType      DocAudienceType
  purposeType       PurposeType
  formatType        FormatType
  summary           String?
  contentSourceType ContentSourceType
  /// Full body for inline-content documents (markdown / richtext /
  /// block_json). For stored-file documents this stores the storage
  /// path. For external-link documents this stores the URL.
  storagePathOrBody String?              @db.Text
  previewText       String?
  isModular         Boolean              @default(false)
  isTemplate        Boolean              @default(false)
  confidentiality   ConfidentialityLevel @default(internal)
  status            DocStatus            @default(draft)
  authoringState    DocAuthoringState    @default(draft)
  sourceKind        DocSourceKind?
  feedsValuation    Boolean              @default(false)
  /// Clerk userId direct (matches LTM convention). Null for public
  /// templates; set on user-owned copies.
  ownerUserId       String?
  /// FK to the template this row was forked from (if any). Used by the
  /// fork endpoint to detect already-owned copies.
  sourceTemplateId  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  sourceTemplate Document?  @relation("TemplateCopies", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies         Document[] @relation("TemplateCopies")
  packageDocs    PackageDocument[]
  bookmarks      DocumentBookmark[]
  shares         DocumentShare[]

  @@index([documentType])
  @@index([audienceType])
  @@index([purposeType])
  @@index([confidentiality])
  @@index([status])
  @@index([ownerUserId])
  @@index([sourceTemplateId])
  @@index([status, audienceType])
  @@index([status, updatedAt])
  @@index([ownerUserId, authoringState])
  @@index([ownerUserId, sourceKind])
  @@unique([ownerUserId, sourceTemplateId])
  @@map("documents")
}

// ─── UserProfile — LTM-aligned (line 1694 of LTM schema, minimum subset) ──

/// Per-user profile keyed off Clerk's `userId`. OB looks up or creates
/// the row on first user-scoped action via `ensureUserProfile()`
/// (`src/lib/users/ensure-user-profile.ts`). Cross-product relations
/// from LTM's UserProfile (DistrictFollow, EventRsvp, salutations,
/// comments, etc.) are not ported — they live on LTM-only tables.
model UserProfile {
  id           String   @id @default(cuid())
  clerkUserId  String   @unique
  displayName  String
  headline     String?
  bio          String?  @db.Text
  jobTitle     String?
  company      String?
  contactEmail String?
  phone        String?
  isPublic     Boolean  @default(true)
  /// Subscription tier for feature gating (drives the share endpoint's
  /// plan-block hook).
  planTier     PlanTier @default(free)

  /// Stripe wiring — mirrored from Stripe webhooks. Lets the UI render
  /// "renews on …" without a live Stripe round-trip.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// Mirror of Stripe subscription.status. String not enum because
  /// Stripe adds new states and we don't want a schema migration each time.
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentBookmarks DocumentBookmark[]

  @@map("user_profiles")
}
