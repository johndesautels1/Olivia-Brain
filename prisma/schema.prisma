  calendarEntry CalendarEntry? @relation(fields: [calendarEntryId], references: [id], onDelete: SetNull)

  @@index([userId, isArchived])
  @@index([userId, calendarEntryId])
  @@index([calendarEntryId])
  @@map("calendar_notes")
}

// ── Voice + Olivia models (added 2026-05-03 — Track Calendar C3) ──────────
//
// 9 models ported from LTM with the same adaptations as C1/C2:
//   - cuid → UUID (id columns: dbgenerated("gen_random_uuid()") @db.Uuid)
//   - userProfileId → userId (no FK constraint; references Clerk userId
//     directly post-Clerk integration)
//   - LTM-domain FK relations dropped: VoiceConversation.userProfile and
//     VoiceContact.linkedPersonId (Olivia Brain doesn't own UserProfile or
//     Person; per project_ltm_types_no_speculative_generalization)
//   - VoiceConversation.calendarEntry kept (CalendarEntry exists in C1)
//   - VoiceConversation.generatedDocumentId / generatedPackageId preserved
//     as plain strings (polymorphic IDs; Document/Package don't exist yet)
//   - VoiceActionItem.calendarEntryId preserved as plain string (LTM also
//     has no FK relation here — polymorphic by design)
//   - sessionToken @default(cuid()) preserved (not an FK target; cuid is
//     a fine session token generator)

// ── OliviaConversation — top-level chat session ──────────────────────────
model OliviaConversation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @db.Uuid
  sessionToken String   @unique @default(cuid())
  title        String?
  pageContext  String?
  mode         String   @default("chat")
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages      OliviaMessage[]
  presentations OliviaPresentation[]

  @@index([userId, createdAt])
  @@index([sessionToken])
  @@map("olivia_conversations")
}

// ── OliviaMessage — individual chat turns inside a conversation ──────────
model OliviaMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @db.Uuid
  role           String
  content        String   @db.Text
  toolName       String?
  toolArgs       Json?
  toolResult     Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation OliviaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("olivia_messages")
}

// ── OliviaPresentation — Gamma-generated presentation tied to a chat ─────
model OliviaPresentation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String?  @db.Uuid
  userId         String?  @db.Uuid
  generationId   String?
  status         String   @default("pending")
  gammaUrl       String?
  exportUrl      String?
  exportFormat   String?
  title          String?
  inputSummary   String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation OliviaConversation? @relation(fields: [conversationId], references: [id])

  @@index([userId, createdAt])
  @@index([conversationId])
  @@map("olivia_presentations")
}

/// Layer 2: GDPR Consent Records — user consent for data storage,
/// AI processing, and learning. userId references Clerk user ID.
model OliviaConsent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
