// ═══════════════════════════════════════════════════════════════════════════
// VALUATION ENGINE — Track V Session V1 (2026-05-07)
// ═══════════════════════════════════════════════════════════════════════════
//
// Cloned from D:\London-Tech-Map\prisma\schema.prisma (LTM Step 2 valuation
// merge) with OB-side adaptations:
//
//   - cuid → @db.Uuid (per OB UUID convention from C1 calendar foundation)
//   - userProfileId → userId (Clerk userId direct, no UserProfile relation
//     since OB does not own UserProfile; same pattern as C2/C3/C4 calendar)
//   - LTM-domain FKs (UserProfile, AnalysisResult, Organization, Document)
//     dropped to plain String fields. The bridge port (V2) decides whether
//     these read via UKP bridge or stub models. See
//     `project_track_v_ltm_valuation_port` memory.
//   - Sales-domain DealRoomSession was DROPPED in C1; the valuation-context
//     DealRoomSession ported here is a DIFFERENT table with a coincidentally
//     identical name. Memory clarification at
//     `project_ltm_types_no_speculative_generalization`.
//
// Track V exception to "do not add LTM Prisma models to OB" rule — valuation-
// domain models are explicitly in scope per founder direction 2026-05-07
// (clone advanced LTM tools into OB; LTM stays untouched).
// ═══════════════════════════════════════════════════════════════════════════

/// User company being valued — JSON columns hold financial/qualitative/IP/
/// market/capital/funding evidence with provenance refs. The bridge layer
/// (V2) reads these to build CompanyValuationInput.
model ValuationSubject {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  companyName   String
  sector        String?
  subsector     String?
  stage         String? // "idea" | "pre_revenue" | "mvp" | "early_revenue" | "growth" | "scaleup" | "mature"
  businessModel String? // "saas" | "marketplace" | "services" | "deeptech" | "fintech" | "ecommerce" | "media" | "hardware" | "other"

  /// Shape: { annualRevenue, arr, grossMarginPct, ebitda, burnMonthly, runwayMonths, growthYoYPct, churnPct, ... } — each MetricEvidence { value, refs[], confidence, asOfDate }
  financialDataJson Json?

  /// Shape: { founderDependencyRisk, legalRisk, ipStrength, productMaturity, goToMarketMaturity, londonStrategicFit, scorecardFactors{team,opportunity,product,...} }
  qualitativeJson   Json?

  /// Shape: { capitalizedBuildCost, replacementCost, patentsCount, proprietaryDataScore, trademarksCount, regulatoryApprovals }
  ipDataJson        Json?

  /// Shape: { tam, sam, som, marketGrowthPct } — each MetricEvidence
  marketDataJson    Json?

  /// Shape: { cashOnHand, debt, fullyDilutedShares, optionPoolPct }
  capitalDataJson   Json?

  /// Shape: { capitalRaisedToDate, lastRoundPreMoney, lastRoundPostMoney }
  fundingDataJson   Json?

  /// Quantara intake-form extension column (Track Q Session Q1).
  /// Holds the ~36 fields from the 56-field founder valuation intake that
  /// don't map to one of the engine-canonical JSON columns above. Subkeys
  /// (camelCase) are owned by `src/lib/quantara/field-mapping.ts`:
  ///   mrr, growthMoMPct, netMarginPct, cacAmount, ltvAmount,
  ///   grossRevenueRetentionPct, lastRoundType, targetRaiseAmount,
  ///   targetRoundType, payingCustomers, pipelineValue,
  ///   monthlyActiveUsers, enterpriseContracts, averageContractValue,
  ///   patentsFiled, proprietaryDatasetDescription,
  ///   openSourceDependencyPct, keyRegulatoryApprovalsText,
  ///   networkEffectsScore, teamSize, technicalStaffPct,
  ///   founderDomainExperienceYears, previousExitsText,
  ///   keyPersonDependencyRisk, revenueConcentrationTopClientPct,
  ///   geographicConcentrationText, regulatoryRiskLevel,
  ///   expansionRevenuePct, viralCoefficient, salesCycleDays,
  ///   rdSpendPctOfRevenue, projectedRevenueY1, projectedRevenueY2,
  ///   projectedRevenueY3, pathToProfitabilityMonths,
  ///   targetExitTimelineYears.
  quantaraJson      Json?

  /// Plain String — AnalysisResult model not in OB; bridge V2 routes through
  /// UKP bridge if needed.
  analysisResultId String? @db.Uuid

  /// 0-100 weighted completeness score derived from the JSON columns.
  completenessScore Decimal? @db.Decimal(5, 2)

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  valuationRuns      ValuationRun[]
  financialSnapshots FinancialSnapshot[]
  /// Q7 — cascade-synthesized founder + company personas keyed off this subject.
  founderPersonas    FounderPersona[]
  companyPersonas    CompanyPersona[]
  /// P1 — Deal Protection analyses run against this subject. Cascading
  /// delete so deal histories don't orphan a soft-deleted subject.
  dealAnalyses       DealAnalysis[]

  @@index([userId, createdAt])
  @@index([analysisResultId])
  @@map("valuation_subjects")
}

/// Single execution of the 10-method valuation engine against a subject.
/// inputSnapshotJson freezes the merged input at run time; resultJson stores
/// the full ReconciledValuationResult; methodWeightsJson stores the
/// stage-aware method weights used.
model ValuationRun {
  id                 String @id @default(uuid()) @db.Uuid
  valuationSubjectId String @db.Uuid

  buyerType        String? // "angel" | "vc" | "private_equity" | "strategic_partner" | "acquirer"
  /// Plain String — Organization model not in OB; bridge V2 reads strategic-
  /// synergy data via UKP if a target match is provided.
  targetMatchOrgId String? @db.Uuid

  inputSnapshotJson Json
  resultJson        Json
  methodWeightsJson Json?

  confidenceScore Decimal? @db.Decimal(5, 2)
  status          String   @default("completed") // "queued" | "processing" | "completed" | "failed"
  runDurationMs   Int?

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  valuationSubject ValuationSubject       @relation(fields: [valuationSubjectId], references: [id], onDelete: Cascade)
  sensitivities    ValuationSensitivity[]
  dealRoomSessions DealRoomSession[]

  @@index([valuationSubjectId, createdAt])
  @@index([targetMatchOrgId])
  @@map("valuation_runs")
}

/// Sensitivity analysis output — one row per varied variable, used to render
/// tornado charts in the dashboard.
model ValuationSensitivity {
  id             String @id @default(uuid()) @db.Uuid
  valuationRunId String @db.Uuid

  variableName  String
  baseValue     Decimal @db.Decimal(18, 2)
  lowValue      Decimal @db.Decimal(18, 2)
  highValue     Decimal @db.Decimal(18, 2)
  lowValuation  Decimal @db.Decimal(18, 2)
  highValuation Decimal @db.Decimal(18, 2)

  valuationRun ValuationRun @relation(fields: [valuationRunId], references: [id], onDelete: Cascade)

  @@unique([valuationRunId, variableName])
  @@index([valuationRunId])
  @@map("valuation_sensitivities")
}

/// Point-in-time financial snapshot — used to track changes over time and
/// to source the FinancialSnapshot fields the engine needs.
model FinancialSnapshot {
  id                 String @id @default(uuid()) @db.Uuid
  valuationSubjectId String @db.Uuid

  snapshotDate   DateTime
  annualRevenue  Decimal? @db.Decimal(18, 2)
  arr            Decimal? @db.Decimal(18, 2)
  grossMarginPct Decimal? @db.Decimal(5, 2)
  ebitda         Decimal? @db.Decimal(18, 2)
  burnMonthly    Decimal? @db.Decimal(18, 2)
  growthYoYPct   Decimal? @db.Decimal(5, 2)
  cashOnHand     Decimal? @db.Decimal(18, 2)
  runwayMonths   Int?
  customerCount  Int?

  /// Plain String[] — Document model not in OB until Track B Session 8;
  /// IDs are stored as strings until then.
  sourceDocumentIds String[] @db.Uuid

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  valuationSubject ValuationSubject @relation(fields: [valuationSubjectId], references: [id], onDelete: Cascade)

  @@index([valuationSubjectId, snapshotDate])
  @@map("financial_snapshots")
}

/// Negotiation-simulator session attached to a valuation run. THIS IS NOT
/// the sales-domain DealRoomSession dropped in C1 (which lived in the calendar
/// + real-estate context). This is the valuation-context backing store for
/// WarRoom + DealRoomSimulator UI ported in V9.
model DealRoomSession {
  id             String @id @default(uuid()) @db.Uuid
  valuationRunId String @db.Uuid
  userId         String @db.Uuid

  buyerType String // "angel" | "vc" | "private_equity" | "strategic_partner" | "acquirer"
  status    String @default("active") // "active" | "completed" | "archived"

  /// Overall readiness score 0-100. Per-dimension breakdown in rubricScoresJson.
  overallScore     Decimal? @db.Decimal(5, 2)
  /// { evidence: number, valuation: number, risk: number, ... } — readiness rubric.
  rubricScoresJson Json?

  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationSeconds Int?

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  valuationRun ValuationRun      @relation(fields: [valuationRunId], references: [id], onDelete: Cascade)
  messages     DealRoomMessage[]

  @@index([userId, createdAt])
  @@index([valuationRunId])
  @@map("deal_room_sessions")
}

/// Message exchanged in a valuation-context DealRoomSession.
model DealRoomMessage {
  id                String @id @default(uuid()) @db.Uuid
  dealRoomSessionId String @db.Uuid

  role    String // "user" | "founder" | "buyer" | "opus_judge" | "system"
  content String @db.Text

  /// Optional references to documents tabled during the negotiation turn.
  /// Plain string[] of document IDs until the Document model lands.
  exhibitsJson Json?

  createdAt DateTime @default(now())

  dealRoomSession DealRoomSession @relation(fields: [dealRoomSessionId], references: [id], onDelete: Cascade)

  @@index([dealRoomSessionId, createdAt])
  @@map("deal_room_messages")
}

// ═══════════════════════════════════════════════════════════════════════════
// QUANTARA Q7 — PERSONA SYNTHESIS (cascade-derived founder + company personas)
// ═══════════════════════════════════════════════════════════════════════════
//
// At 100% Quantara completeness the founder can request persona synthesis
// from the Q7 cascade. Output is two coherent records — a FounderPersona
// (team / risk / projections / strategic + Q5 supplementary) and a
// CompanyPersona (financials / market / IP / capital + Q6 vertical
// schedule). Both are read by downstream consumers (Pitch Deck Studio,
// Business Plan generator, Marketing) when those tracks land.
//
// Synthesis runs through `runModelCascade` with `intent: "questionnaire"`
// so Gemini extracts → Sonnet evaluates → Opus would judge if requested.
// Regeneration is manual (button in the form) until Brain Enrichment
// Engine wires automatic invalidation; new entries are appended (not
// overwritten) so downstream consumers can compare versions.

/// Cascade-synthesized founder persona. Built from the Quantara intake's
/// team + risk + projections + strategic sections plus the round-axis
/// supplementary entries. Read by downstream consumers (Pitch Deck Studio,
/// Business Plan generator, Marketing — when those tracks land) to anchor
/// founder-narrative-driven content. Regeneration is manual; new entries
/// are appended (not overwritten) so the founder can compare versions.
model FounderPersona {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Owner — references Clerk user ID directly (parity with the rest of OB).
  userId             String @db.Uuid
  /// Source subject. Cascading delete so personas don't orphan a
  /// soft-deleted subject.
  valuationSubjectId String @db.Uuid

  /// One-paragraph summary surfaced in the Olivia inspector tab.
  summary        String @db.Text
  /// One-line narrative angle for pitch / business plan introductions.
  narrativeAngle String @db.Text
  /// Shape: `{ strengths: string[], workingStyle: string, archetype: string,
  ///           riskTolerance: "low" | "medium" | "high" }`. JSON so the
  /// shape can evolve without schema churn.
  strengthsJson  Json
  /// Shape: `{ gaps: string[], openQuestions: string[] }`.
  gapsJson       Json
  /// Stable schema version — bumped when the synthesis prompt changes
  /// in a non-additive way. Lets BEE invalidate dependent records when a
  /// schema-version bump lands (post-Q7).
  personaSchemaVersion Int  @default(1)
  /// Cascade trail — which provider produced the synthesis + per-attempt
  /// durationMs + success flag. Same shape as `conversation_turns.metadata.attempts`.
  modelTrailJson Json
  /// "live" | "mock" — surfaces in the UI so the founder knows whether
  /// the persona was synthesised against real LLMs or the mock-mode
  /// degraded path.
  runtimeMode    String

  generatedAt DateTime @default(now())
  isArchived  Boolean  @default(false)

  valuationSubject ValuationSubject @relation(fields: [valuationSubjectId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@index([valuationSubjectId, generatedAt])
  @@map("founder_personas")
}

/// Cascade-synthesized company persona. Built from the Quantara intake's
/// financials + market + IP + capital sections plus the vertical-axis
/// schedule entries. Pairs with FounderPersona — both are produced in the
/// same synthesis call to keep them coherent.
model CompanyPersona {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String @db.Uuid
  valuationSubjectId String @db.Uuid

  summary       String @db.Text
  /// What the company sells, how it makes money, what's unique.
  positioning   String @db.Text
  /// "We grew from X to Y because Z" — narrative anchor for decks.
  tractionStory String @db.Text
  /// Shape: `{ differentiators: string[], idealCustomer: string,
  ///           defensibility: string }`. JSON so the shape can evolve.
  differentiatorsJson Json
  /// Shape: `{ watchOuts: string[], openQuestions: string[] }`.
  watchOutsJson       Json
  personaSchemaVersion Int   @default(1)
  modelTrailJson      Json
  runtimeMode         String

  generatedAt DateTime @default(now())
  isArchived  Boolean  @default(false)

  valuationSubject ValuationSubject @relation(fields: [valuationSubjectId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@index([valuationSubjectId, generatedAt])
  @@map("company_personas")
}

// ═══════════════════════════════════════════════════════════════════════════
// TRACK P — DEAL PROTECTION ENGINE (term-sheet analysis + investor reputation)
// ═══════════════════════════════════════════════════════════════════════════
//
// At every funding round, the founder uploads or pastes a term sheet; the
// Deal Protection cascade returns a smart score (0–100), a band
// (red/orange/yellow/blue/green), per-clause toxicity, an investor
// reputation snapshot, plus a band-tailored recommended action.
//
// P1 ships the schema + the smart-score module. P2 adds the clause
// classifier. P3 builds the term-sheet parser + analyze API. P4 seeds
// + admin-CRUDs the investor reputation table. P5–P7 build dilution
// projection, email drafts, WarRoom integration, and rehearsal modes.

/// Single Deal Protection run on a term sheet against a valuation subject.
/// Append-only — re-running on a revised term sheet creates a new row so
/// the founder can compare versions across negotiation cycles. Cascading
/// delete from valuation_subjects so analyses don't orphan a soft-deleted
/// subject.
model DealAnalysis {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Owner — references Clerk user ID directly.
  userId             String @db.Uuid
  /// Source subject (the company being valued). Cascading delete.
  valuationSubjectId String @db.Uuid

  /// 0-100 smart score. Higher = more founder-friendly. P1 ships the
  /// band/language ladder; P3 wires the cascade-derived score itself.
  smartScore        Decimal @db.Decimal(5, 2)
  /// One of: 'red' | 'orange' | 'yellow' | 'blue' | 'green'. Stable
  /// for the lifetime of the platform — see SMART_BANDS in
  /// `src/lib/deal-protection/bands.ts`.
  smartBand         String
  /// Plain-language summary surfaced to the founder ("This term sheet…").
  bandLanguage      String  @db.Text
  /// Recommended action ("walk away" / "negotiate hard" / "sign with edits").
  recommendedAction String  @db.Text
  /// Investor signal — what this deal communicates about the investor's
  /// stance ("Standard Series A terms" vs "Aggressive PIK structure").
  investorSignal    String  @db.Text

  /// Term-sheet text the analysis ran on. Optional in P1 (the analysis
  /// can run on structured inputs); P3's parser populates it.
  termSheetText     String? @db.Text
  /// Investor names on the deal — for InvestorReputation lookup. Array of
  /// names; matched case-insensitively against `investor_reputations.name`.
  investorNamesJson Json?
  /// Per-clause analysis array — populated by P2 clause classifier.
  /// Shape: `[{ clauseType, severity, toxicity, founderFriendlyAlternative }]`.
  clauseAnalysisJson Json?
  /// 0-1 confidence on the smart score itself, derived from V3
  /// confidence math. Lower = "review with counsel".
  confidenceScore   Decimal @db.Decimal(3, 2)
  /// Cascade trail (provider + model + per-attempt durationMs / success).
  /// Same shape as `conversation_turns.metadata.attempts`.
  modelTrailJson    Json?
  /// "live" | "mock" — surfaces in the UI so a mock-mode run is never
  /// mistaken for live cascade output.
  runtimeMode       String  @default("mock")

  generatedAt DateTime @default(now())
  isArchived  Boolean  @default(false)

  valuationSubject  ValuationSubject   @relation(fields: [valuationSubjectId], references: [id], onDelete: Cascade)
  counterTermSheets CounterTermSheet[]

  @@index([userId, generatedAt])
  @@index([valuationSubjectId, generatedAt])
  @@map("deal_analyses")
}

/// Cascade-drafted founder-side counter term sheet for a Deal Protection
/// run. Append-only with a per-analysis `versionNumber` so the founder
/// can iterate on the counter as the negotiation evolves. Cascading
/// delete from deal_analyses so counters don't orphan a soft-deleted
/// analysis. Cross-doc inheritance: company / sector / round context
/// flow through from the parent ValuationSubject + DealAnalysis at
/// generation time; this row stores only the redline output.
model CounterTermSheet {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Owner — references Clerk user ID directly.
  userId         String @db.Uuid
  /// Parent Deal Protection analysis. Cascading delete.
  dealAnalysisId String @db.Uuid

  /// Per-analysis version number — increments with each new draft so
  /// the negotiation history is auditable. 1 for the first counter,
  /// 2 for the next regeneration, etc.
  versionNumber Int @default(1)

  /// Rendered redlined markdown — the document the founder copies
  /// into their email / lawyer's redlines. Includes preamble +
  /// per-clause counter language + closing.
  redlinedMarkdown String @db.Text

  /// Structured changes for UI rendering — array of
  /// `{ clauseType, originalText, counterText, rationale }` records.
  /// Lets a side-by-side viewer or tracked-changes overlay render
  /// without re-parsing the markdown.
  changesJson Json?

  /// Optional founder notes attached to this draft (e.g. "after legal
  /// review, drop item 3"). Editable by the founder; persisted on save.
  founderNotes String? @db.Text

  /// Cascade trail (provider + model + per-attempt durationMs / success).
  /// Same shape as `conversation_turns.metadata.attempts`.
  modelTrailJson Json?

  /// "live" | "mock" — surfaces in the UI so a deterministic-template
  /// fallback is never mistaken for a cascade-drafted counter.
  runtimeMode String @default("mock")

  generatedAt DateTime @default(now())
  isArchived  Boolean  @default(false)

  dealAnalysis DealAnalysis @relation(fields: [dealAnalysisId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@index([dealAnalysisId, versionNumber])
  @@map("counter_term_sheets")
}

/// Investor reputation entry. Lookup table seeded with London-ecosystem
/// data (P4), extended with admin-managed entries and (post-moderation)
/// founder-submitted ones. P3 reads this when computing smart scores so
/// the same term sheet from a known-aggressive investor scores worse than
/// from a known-friendly one.
model InvestorReputation {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Canonical investor name (e.g. "Atomico", "Octopus Ventures"). Case-
  /// preserving on display; matched case-insensitively at lookup time.
  name            String @unique
  /// Stable lowercase slug for URLs / API lookups.
  slug            String @unique
  /// 'angel' | 'vc' | 'private_equity' | 'strategic' | 'family_office' | 'other'.
  investorType    String
  /// Geographic focus — free text (e.g. "UK + EU", "Global", "London-only").
  geographicFocus String?
  /// Stage focus — array of TargetRoundType values
  /// (Seed / Series A / Series B / Series C / Growth / Strategic).
  stageFocusJson  Json?
  /// Sector focus — array of vertical IDs or free-text sector strings.
  sectorFocusJson Json?

  /// 0-100 reputation score. Higher = more founder-friendly. Aggregated
  /// from observed clause toxicity + founder feedback + public deal data.
  reputationScore Decimal @db.Decimal(5, 2)
  /// 'red' | 'orange' | 'yellow' | 'blue' | 'green' (same ladder as
  /// DealAnalysis.smartBand).
  reputationBand  String

  /// Common patterns this investor has shown — array of strings from a
  /// stable vocabulary (e.g. 'standard_1x_liq_pref',
  /// 'aggressive_anti_dilution', 'multi_tranche_milestone_gated').
  patternsJson    Json?
  /// Editor's note — plain-text caveat / context / "watch out for X".
  notes           String? @db.Text

  /// Origin: 'seed' (P4 initial London-ecosystem seed), 'admin' (P4 manual
  /// entry), 'founder_submitted' (P4 moderation queue path).
  source          String  @default("seed")
  /// Whether this entry surfaces in the smart-score lookup. Toggled off
  /// (rather than archived) when a record is being reviewed but not yet
  /// removed.
  isActive        Boolean @default(true)
  isArchived      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([investorType, isActive])
  @@index([reputationBand, isActive])
  @@map("investor_reputations")
}

// ─── Track B Session 8b-routes — Documents engine write surface ───────────────
//
// **LTM-aligned shapes.** OB will nest inside the London Tech Map app
// as the home tenant — every model in this section mirrors the
// equivalent LTM model in `D:\London-Tech-Map\prisma\schema.prisma`
// (column names, table names, FK relationships, sortOrder/isRequired
// semantics on PackageDocument). The minimum-viable subset of LTM
// fields ships here; LTM-only optional fields that reference tables
// OB doesn't have yet (TargetList, PackageTemplate, Person,
// Organization, etc.) are deliberately omitted and re-added when
// those tables port in.
//
// **Two user-id conventions, both deliberately following LTM:**
// - `userProfileId` on `DocumentBookmark` — LTM's bookmark table FKs
//   to `UserProfile` (LTM's own user table whose `clerkUserId` field
//   maps to Clerk's `user_xxx` ID). OB doesn't have UserProfile yet
//   (lands in Session 8d alongside the Document model). Until then
//   we store the raw Clerk userId / `STUB_USER_ID` env value in the
//   `userProfileId` column. The column is named for the destination
//   shape so the migration adds an FK without renaming any column
//   when UserProfile arrives.
// - `ownerUserId` on `Package` and `DocumentShare` — LTM stores the
//   raw Clerk userId here directly (see LTM `Package.ownerUserId` +
//   `DocumentShare.ownerUserId`, both `String` not FK to UserProfile).
//   No future migration needed for these; they already match LTM.
//
// **`documentId` is a loose `String`** (no FK to a `Document` table)
// because OB doesn't have a `Document` Prisma model yet. The FK lands
// when Session 8d ports the Document model alongside the documents
// app routes. Consumers tolerate dangling references today; a 404
// from the documents reader is the right behaviour.

/// LTM-aligned bookmark. Compound unique on `[userProfileId, documentId]`
/// makes the toggle endpoint idempotent and "is bookmarked?" a single
/// point lookup. Mirrors `LTM.DocumentBookmark` (line 1955 of LTM
/// schema). FK to `UserProfile` + `Document` landed in Session 8d
/// (this session) — both relations now enforce referential integrity.
model DocumentBookmark {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userProfileId String
  documentId    String
  createdAt     DateTime @default(now())

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, documentId])
  @@index([userProfileId])
  @@index([documentId])
  @@map("document_bookmarks")
}

/// LTM-aligned package. Mirrors `LTM.Package` (line 1461 of LTM
/// schema): `ownerUserId` (Clerk userId direct), `outreachGoal`,
/// `packageStatus`, optional `summary` + `shareToken` + `expiresAt`.
/// LTM fields that reference unported tables (`targetListId`,
/// `packageTemplateId`, `personalizationJson`) are deferred. LTM
/// uses enums for `outreachGoal` (OutreachGoal) + `packageStatus`
/// (PackageStatus); OB stores them as `String` until those enums
/// port — column shape is identical so the type tightening is a
/// non-breaking enum migration when it lands.
model Package {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  ownerUserId   String?
  /// LTM-aligned enum (Session 8d tightened from `String`). Values:
  /// fundraising / strategic_partnership / white_label / pilot /
  /// reseller / acquisition / enterprise_sales.
  outreachGoal  OutreachGoal
  /// LTM-aligned enum (Session 8d tightened from `String`). Values:
  /// draft / ready / sent / viewed / engaged / closed / package_archived.
  packageStatus PackageStatus @default(draft)
  summary       String?
  shareToken    String?       @unique
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  packageDocuments PackageDocument[]

  @@index([ownerUserId])
  @@index([outreachGoal])
  @@index([packageStatus])
  @@index([shareToken])
  @@map("packages")
}

/// LTM-aligned package-document join. Mirrors `LTM.PackageDocument`
/// (line 1499 of LTM schema): `sortOrder` (not `position`),
/// `isRequired`, `customIntro`. LTM uses `onDelete: Restrict` on
/// the package FK so deleting a Package while it has documents is
/// rejected — preserved here for parity. LTM's `visibilityRule`
/// + `generatedOverlayJson` are optional fields that defer to
/// follow-up port.
model PackageDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId   String   @db.Uuid
  documentId  String
  sortOrder   Int      @default(0)
  isRequired  Boolean  @default(true)
  customIntro String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  package  Package  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([packageId, documentId])
  @@index([packageId])
  @@index([documentId])
  @@index([sortOrder])
  @@map("package_documents")
}

/// LTM-aligned per-document share link. Mirrors `LTM.DocumentShare`
/// (line 1411 of LTM schema): `ownerUserId` (Clerk userId direct,
/// matches LTM's `Document.ownerUserId`), opaque `shareToken`,
/// optional recipient + expiry, soft-revocable. LTM's
/// `DocumentShareEvent` audit table (line 1444) is not ported in
/// this session — view-count + lastViewedAt cover the immediate UI
/// needs, the per-event audit trail can land in a follow-up.
model DocumentShare {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String
  ownerUserId    String
  shareToken     String    @unique
  recipientEmail String?
  recipientName  String?
  message        String?   @db.Text
  expiresAt      DateTime?
  isRevoked      Boolean   @default(false)
  viewCount      Int       @default(0)
  lastViewedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([ownerUserId])
  @@index([shareToken])
  @@map("document_shares")
}

// ─── Track B Session 8d — Documents foundation (Document + UserProfile + enums) ─
//
// **LTM-aligned shapes.** Full LTM enum set + Document + UserProfile
// minimum-viable subset, ported byte-for-byte where the columns exist
// in LTM. Differences from LTM (all deliberate):
//
// - `Document.collectionId` is **optional** in OB (LTM marks it required
//   FK to `DocumentCollection`). OB doesn't have `DocumentCollection`
//   yet — that table + its consumers (collection-tier filtering on
//   the documents index) port in a follow-up. The column shape is
//   preserved so a follow-up migration can add the FK without
//   renaming.
// - LTM's `DocumentVersion`, `DocumentModule`, `DocumentRelationship`
//   tables are not ported — those are append-only audit tables with
//   no current consumer in OB. Land when the documents app routes
//   ship a "version history" or "module composition" feature.
// - `UserProfile` is the minimum-viable subset (id, clerkUserId,
//   displayName, headline, bio, jobTitle, company, contactEmail,
//   phone, isPublic, planTier, Stripe wiring, timestamps). The many
//   LTM cross-product relations (DistrictFollow, EventRsvp, salutations,
//   comments, valuationSubjects, dealRoomSessions, etc.) are not
//   ported — they live in LTM-only tables. The `documentBookmarks`
//   relation is ported; the `valuationSubjects` relation is wired in
//   ValuationSubject in a follow-up edit if needed for cross-table FK
//   pressure.

// ─── Enums (12 new) ────────────────────────────────────────────────────────

