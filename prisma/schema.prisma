  source String @default("voice_call")

  conversations VoiceConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([company])
  @@map("voice_contacts")
}

// ── VoiceActionItem — task extracted from a call transcript ──────────────
// calendarEntryId is polymorphic (no FK) — matches LTM behavior.
model VoiceActionItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  conversationId String            @db.Uuid
  conversation   VoiceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  action     String
  assignedTo String
  dueDate    DateTime?
  priority   String    @default("medium")

  status         String    @default("pending")
  completedAt    DateTime?
  completionNote String?

  calendarEntryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

