generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model admin_audit_logs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type String
  actor      String
  summary    String
  metadata   Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)])
  @@index([event_type, created_at(sort: Desc)], map: "admin_audit_logs_event_type_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model conversation_turns {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String                 @db.Uuid
  role            String
  content         String
  metadata        Json                   @default("{}")
  created_at      DateTime               @default(now()) @db.Timestamptz(6)
  embedding       Unsupported("vector")?
  expires_at      DateTime?              @db.Timestamptz(6)
  conversations   conversations          @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at(sort: Desc)], map: "conversation_turns_conversation_id_idx")
  @@index([embedding])
  @@index([expires_at], where: raw("(expires_at IS NOT NULL)"))
}

model conversations {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String?
  metadata           Json                 @default("{}")
  last_message_at    DateTime             @default(now()) @db.Timestamptz(6)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  client_id            String?
  conversation_turns   conversation_turns[]
  conversation_events  conversation_events[]
  journey_snapshots    journey_snapshots[]
  action_budgets       action_budgets[]

  @@index([client_id, created_at(sort: Desc)], map: "conversations_client_id_idx")
}

/// Event-sourced conversation ledger — typed, ordered events for replay and projections.
/// Layered on top of conversation_turns (additive, does not replace).
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model conversation_events {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id  String               @db.Uuid
  client_id        String?
  event_type       String
  sequence_num     Int
  payload          Json                 @default("{}")
  actor            String
  parent_event_id  String?              @db.Uuid
  created_at       DateTime             @default(now()) @db.Timestamptz(6)
  conversation     conversations        @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent_event     conversation_events? @relation("event_chain", fields: [parent_event_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  child_events     conversation_events[] @relation("event_chain")

  @@unique([conversation_id, sequence_num], map: "conversation_events_sequence_unique")
  @@index([conversation_id, sequence_num(sort: Asc)], map: "conversation_events_replay_idx")
  @@index([conversation_id, event_type], map: "conversation_events_type_idx")
  @@index([client_id, created_at(sort: Desc)], map: "conversation_events_client_idx", where: raw("(client_id IS NOT NULL)"))
  @@index([parent_event_id], map: "conversation_events_parent_idx", where: raw("(parent_event_id IS NOT NULL)"))
}

model foundation_traces {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id   String   @db.Uuid
  intent            String
  runtime_mode      String
  selected_provider String
  payload           Json     @default("{}")
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@index([conversation_id, created_at(sort: Desc)], map: "foundation_traces_conversation_id_idx")
}

model integration_test_runs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integration_id String
  action         String
  ok             Boolean
  actor          String
  summary        String
  details        Json     @default("[]")
  tested_at      DateTime @default(now()) @db.Timestamptz(6)
  duration_ms    Int      @default(0)

  @@index([integration_id, tested_at(sort: Desc)], map: "integration_test_runs_integration_id_idx")
  @@index([tested_at(sort: Desc)])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model knowledge_chunks {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source      String
  chunk_index Int                    @default(0)
  chunk_text  String
  metadata    Json                   @default("{}")
  embedding   Unsupported("vector")?
  created_at  DateTime               @default(now()) @db.Timestamptz(6)
  client_id   String?
  expires_at  DateTime?              @db.Timestamptz(6)

  @@index([embedding])
  @@index([client_id, created_at(sort: Desc)], map: "knowledge_chunks_client_id_idx")
  @@index([expires_at], where: raw("(expires_at IS NOT NULL)"))
}

model mem0_memories {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id        String
  mem0_id          String    @unique
  memory_type      String    @default("general")
  content          String
  metadata         Json      @default("{}")
  importance_score Float     @default(0.5) @db.Real
  last_accessed_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at       DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([client_id, importance_score(sort: Desc)], map: "mem0_memories_client_id_idx")
  @@index([expires_at], where: raw("(expires_at IS NOT NULL)"))
  @@index([last_accessed_at], map: "mem0_memories_last_accessed_idx")
  @@index([mem0_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// Knowledge graph entity storage — hybrid public/private isolation
model graph_entities {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  type                  String                 @default("concept")
  properties            Json                   @default("{}")
  embedding             Unsupported("vector")?
  chunk_ids             String[]               @default([])
  source                String?
  client_id             String?
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  outgoing_relationships graph_relationships[] @relation("source_entity")
  incoming_relationships graph_relationships[] @relation("target_entity")

  @@index([type], map: "graph_entities_type_idx")
  @@index([embedding], map: "graph_entities_embedding_idx")
  @@index([client_id, created_at(sort: Desc)], map: "graph_entities_client_id_idx")
}

/// Knowledge graph relationship storage — connects entities with typed, weighted edges
model graph_relationships {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_entity_id String          @db.Uuid
  target_entity_id String          @db.Uuid
  type             String          @default("related_to")
  label            String?
  weight           Float           @default(0.5) @db.Real
  properties       Json            @default("{}")
  evidence         String?
  client_id        String?
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  source_entity    graph_entities  @relation("source_entity", fields: [source_entity_id], references: [id], onDelete: Cascade)
  target_entity    graph_entities  @relation("target_entity", fields: [target_entity_id], references: [id], onDelete: Cascade)

  @@index([source_entity_id], map: "graph_relationships_source_idx")
  @@index([target_entity_id], map: "graph_relationships_target_idx")
  @@index([type], map: "graph_relationships_type_idx")
  @@index([client_id, created_at(sort: Desc)], map: "graph_relationships_client_id_idx")
}

/// Episodic memory — coherent conversation episodes with LLM-generated summaries.
/// Always private (client_id required). Created at conversation end.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model episodes {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id         String
  conversation_id   String                 @db.Uuid
  title             String
  summary           String
  topics            String[]               @default([])
  participants      String[]               @default([])
  outcome           String?
  turn_ids          String[]               @default([]) @db.Uuid
  start_at          DateTime               @db.Timestamptz(6)
  end_at            DateTime               @db.Timestamptz(6)
  embedding         Unsupported("vector")?
  linked_entity_ids String[]               @default([]) @db.Uuid
  parent_episode_id String?                @db.Uuid
  created_at        DateTime               @default(now()) @db.Timestamptz(6)
  parent_episode    episodes?              @relation("episode_chain", fields: [parent_episode_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  child_episodes    episodes[]             @relation("episode_chain")

  @@index([client_id, end_at(sort: Desc)], map: "episodes_client_id_idx")
  @@index([conversation_id], map: "episodes_conversation_id_idx")
  @@index([embedding], map: "episodes_embedding_idx")
  @@index([parent_episode_id], map: "episodes_parent_episode_id_idx", where: raw("(parent_episode_id IS NOT NULL)"))
}

/// Semantic memory — distilled facts, preferences, insights, and constraints.
/// Public facts (client_id NULL) shared. Private facts (client_id set) isolated.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model semantic_memories {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id           String?
  content             String
  category            String                 @default("fact")
  confidence          Float                  @default(0.7) @db.Real
  source_episode_ids  String[]               @default([]) @db.Uuid
  entity_ids          String[]               @default([]) @db.Uuid
  embedding           Unsupported("vector")?
  superseded_by       String?                @db.Uuid
  last_reinforced_at  DateTime               @default(now()) @db.Timestamptz(6)
  created_at          DateTime               @default(now()) @db.Timestamptz(6)
  superseding_memory  semantic_memories?     @relation("supersede_chain", fields: [superseded_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  superseded_memories semantic_memories[]    @relation("supersede_chain")

  @@index([client_id, confidence(sort: Desc)], map: "semantic_memories_client_confidence_idx")
  @@index([category], map: "semantic_memories_category_idx")
  @@index([embedding], map: "semantic_memories_embedding_idx")
  @@index([superseded_by], map: "semantic_memories_superseded_by_idx", where: raw("(superseded_by IS NOT NULL)"))
  @@index([last_reinforced_at], map: "semantic_memories_reinforced_idx")
}

/// Procedural memory — learned workflows, tool preferences, and patterns.
/// Public procedures (client_id NULL) shared. Private procedures (client_id set) isolated.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model procedural_memories {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id     String?
  name          String
  description   String
  trigger       String
  steps         Json                   @default("[]")
  category      String                 @default("workflow")
  success_count Int                    @default(0)
  failure_count Int                    @default(0)
  embedding          Unsupported("vector")?
  is_active          Boolean                @default(true)
  created_at         DateTime               @default(now()) @db.Timestamptz(6)
  updated_at         DateTime               @default(now()) @db.Timestamptz(6)
  journey_snapshots  journey_snapshots[]

  @@index([client_id, is_active], map: "procedural_memories_client_active_idx")
  @@index([category], map: "procedural_memories_category_idx")
  @@index([embedding], map: "procedural_memories_embedding_idx")
  @@index([name], map: "procedural_memories_name_idx")
}

/// Journey snapshot — point-in-time serialization of conversation state for instant resume.
/// Always private (client_id required). Links to active procedure and conversation events.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model journey_snapshots {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id      String                @db.Uuid
  client_id            String
  snapshot_type        String                @default("auto")
  active_procedure_id  String?               @db.Uuid
  procedure_step_index Int                   @default(0)
  collected_data       Json                  @default("{}")
  pending_questions    Json                  @default("[]")
  context_summary      String
  sentiment            String?
  last_event_sequence  Int                   @default(0)
  metadata             Json                  @default("{}")
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  conversation         conversations         @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  active_procedure     procedural_memories?  @relation(fields: [active_procedure_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([conversation_id, created_at(sort: Desc)], map: "journey_snapshots_conversation_idx")
  @@index([client_id, created_at(sort: Desc)], map: "journey_snapshots_client_idx")
  @@index([active_procedure_id], map: "journey_snapshots_procedure_idx", where: raw("(active_procedure_id IS NOT NULL)"))
}

/// Action budgets — caps on LLM calls, tool invocations, and API requests per conversation.
/// Prevents runaway loops and cost overruns. Atomic consume via RPC.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model action_budgets {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  client_id       String?
  budget_type     String
  max_allowed     Int
  consumed        Int           @default(0)
  period          String        @default("conversation")
  reset_at        DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  conversation    conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([conversation_id, budget_type], map: "action_budgets_unique")
  @@index([conversation_id], map: "action_budgets_conversation_idx")
  @@index([reset_at], map: "action_budgets_reset_idx", where: raw("(reset_at IS NOT NULL)"))
  @@index([client_id, created_at(sort: Desc)], map: "action_budgets_client_idx", where: raw("(client_id IS NOT NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pending_approvals {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tool_name           String
  action_name         String
  params              Json                  @default("{}")
  risk_level          String
  confidence_score    Float                 @db.Real
  reasoning           String
  requested_by        String
  client_id           String?
  conversation_id     String?
  status              String                @default("pending")
  expires_at          DateTime              @db.Timestamptz(6)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  resolved_at         DateTime?             @db.Timestamptz(6)
  resolved_by         String?
  resolution_note     String?
  tool_execution_logs tool_execution_logs[]

  @@index([client_id, created_at(sort: Desc)], map: "pending_approvals_client_idx", where: raw("(client_id IS NOT NULL)"))
  @@index([conversation_id, created_at(sort: Desc)], map: "pending_approvals_conversation_idx", where: raw("(conversation_id IS NOT NULL)"))
  @@index([status, expires_at(sort: Desc)], map: "pending_approvals_status_idx", where: raw("(status = 'pending'::text)"))
}

model tool_execution_logs {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tool_name         String
  action_name       String
  params            Json               @default("{}")
  result            Json?
  success           Boolean
  error_message     String?
  confidence_score  Float?             @db.Real
  approval_id       String?            @db.Uuid
  executed_by       String
  client_id         String?
  conversation_id   String?
  duration_ms       Int?
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  pending_approvals pending_approvals? @relation(fields: [approval_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([client_id, created_at(sort: Desc)], map: "tool_execution_logs_client_idx", where: raw("(client_id IS NOT NULL)"))
  @@index([success, created_at(sort: Desc)], map: "tool_execution_logs_success_idx")
  @@index([tool_name, action_name, created_at(sort: Desc)], map: "tool_execution_logs_tool_idx")
}

// ═══════════════════════════════════════════════════════════════════════════
// AGENT SYSTEM — 250-Agent Autonomous Dashboard
// ═══════════════════════════════════════════════════════════════════════════

/// Agent groups organize agents by category (persona, domain, infrastructure, integration)
model agent_groups {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique // "1A", "2B", etc.
  name        String
  description String?
  category    String   @default("domain") // persona, domain, infrastructure, integration
  sort_order  Int      @default(0)
  is_archived Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  agents      agents[]

  @@index([sort_order])
  @@index([category])
}

/// Individual agents in the 250-agent system
model agents {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id           String            @unique // "O1-001", "O2-015", etc.
  name               String
  description        String?
  group_id           String            @db.Uuid
  status             String            @default("initializing") // active, paused, disabled, error, initializing
  persona            String?           // olivia, cristiano, emelia, system
  llm_model          String            @default("gpt-4o")
  temperature        Float             @default(0.7) @db.Real
  max_tokens         Int               @default(4096)
  system_prompt      String?
  schedule_type      String            @default("on_demand") // on_demand, realtime, hourly, daily, weekly, event_driven, cron
  schedule_cron      String?
  rate_limit_per_min Int               @default(10)
  rate_limit_per_day Int               @default(100)
  total_runs         Int               @default(0)
  successful_runs    Int               @default(0)
  failed_runs        Int               @default(0)
  total_cost_usd     Float             @default(0) @db.Real
  avg_latency_ms     Float             @default(0) @db.Real
  performance_score  Float             @default(0) @db.Real
  last_run_at        DateTime?         @db.Timestamptz(6)
  last_error_at      DateTime?         @db.Timestamptz(6)
  last_error         String?
  is_archived        Boolean           @default(false)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @default(now()) @db.Timestamptz(6)
  agent_group        agent_groups      @relation(fields: [group_id], references: [id], onDelete: Cascade)
  agent_runs         agent_runs[]
  agent_configs      agent_configs[]
  agent_briefings    agent_briefings[]
  agent_learnings    agent_learnings[]
  agent_metrics      agent_metrics[]

  @@index([group_id])
  @@index([status])
  @@index([persona], where: raw("(persona IS NOT NULL)"))
  @@index([performance_score(sort: Desc)])
  @@index([last_run_at(sort: Desc)])
}

/// Individual agent execution runs
model agent_runs {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id         String            @db.Uuid
  status           String            @default("running") // running, completed, failed, timeout, cancelled
  trigger_type     String            @default("manual") // manual, scheduled, event, api, cascade, user_request
  trigger_user_id  String?
  input_json       Json              @default("{}")
  output_json      Json              @default("{}")
  error_message    String?
  duration_ms      Int?
  tokens_used      Int?
  cost_usd         Float?            @db.Real
  llm_model        String?
  cascade_step     Int?
  started_at       DateTime          @default(now()) @db.Timestamptz(6)
  completed_at     DateTime?         @db.Timestamptz(6)
  agent            agents            @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  agent_learnings  agent_learnings[]

  @@index([agent_id, started_at(sort: Desc)])
  @@index([status, started_at(sort: Desc)])
  @@index([trigger_type, started_at(sort: Desc)])
}

/// Agent configuration key-value pairs
model agent_configs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id   String   @db.Uuid
  key        String
  value      String
  is_secret  Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  agent      agents   @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@unique([agent_id, key])
  @@index([agent_id])
}

/// Agent briefings (daily summaries, alerts, milestones)
model agent_briefings {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id           String   @db.Uuid
  briefing_type      String   @default("daily") // daily, weekly, alert, milestone
  title              String
  summary            String
  findings_json      Json     @default("{}")
  recommendations_json Json   @default("{}")
  severity           String   @default("info") // info, warning, critical
  is_read            Boolean  @default(false)
  period_start       DateTime @db.Timestamptz(6)
  period_end         DateTime @db.Timestamptz(6)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  agent              agents   @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@index([agent_id, created_at(sort: Desc)])
  @@index([is_read, created_at(sort: Desc)])
  @@index([severity, created_at(sort: Desc)])
}

/// Agent learnings (patterns, preferences, corrections)
model agent_learnings {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id      String      @db.Uuid
  run_id        String?     @db.Uuid
  learning_type String      @default("insight") // pattern, preference, correction, insight, feedback, optimization
  title         String
  description   String
  data_json     Json        @default("{}")
  confidence    Float       @default(0.7) @db.Real
  applied_count Int         @default(0)
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  agent         agents      @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  run           agent_runs? @relation(fields: [run_id], references: [id], onDelete: SetNull)

  @@index([agent_id, is_active])
  @@index([learning_type])
  @@index([confidence(sort: Desc)])
}

/// Daily agent metrics for analytics/charting
model agent_metrics {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id          String   @db.Uuid
  date              DateTime @db.Date
  runs_total        Int      @default(0)
  runs_successful   Int      @default(0)
  runs_failed       Int      @default(0)
  avg_latency_ms    Float    @default(0) @db.Real
  total_cost_usd    Float    @default(0) @db.Real
  tokens_used       Int      @default(0)
  user_interactions Int      @default(0)
  performance_score Float    @default(0) @db.Real
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  agent             agents   @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@unique([agent_id, date])
  @@index([agent_id, date(sort: Desc)])
}

/// System alerts (cross-agent, system-level)
model system_alerts {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source     String   // "cascade", "agent_O1-001", "system"
  severity   String   @default("info") // info, warning, critical
  title      String
  message    String
  metadata   Json     @default("{}")
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([is_read, created_at(sort: Desc)])
  @@index([severity, created_at(sort: Desc)])
}

/// Feature toggles for system-wide kill switches
model feature_toggles {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  enabled     Boolean  @default(true)
  description String?
  updated_by  String?
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
}

/// Authorized admin emails for system access
model admin_emails {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  role       String   @default("admin") // superadmin, admin, viewer
  name       String?
  is_active  Boolean  @default(true)
  added_by   String?
  last_login DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([is_active])
  @@index([role])
}

// ═══════════════════════════════════════════════════════════════════════════
// MULTI-TENANT ARCHITECTURE — Sprint 5.1
// ═══════════════════════════════════════════════════════════════════════════

/// Core tenant identity — isolated organizational units
model tenants {
  id                     String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String                    @unique // URL-safe identifier: "acme-corp"
  name                   String                    // Display name: "Acme Corporation"
  status                 String                    @default("active") // active, suspended, trial, churned
  tier                   String                    @default("starter") // starter, professional, enterprise, white_label
  domain                 String?                   @unique // Custom domain: "ai.acmecorp.com"
  logo_url               String?
  primary_color          String?                   // Brand color hex
  timezone               String                    @default("UTC")
  locale                 String                    @default("en-US")
  // Limits
  max_seats              Int                       @default(5)
  max_conversations_day  Int                       @default(100)
  max_tokens_month       Int                       @default(1000000)
  tokens_used_month      Int                       @default(0)
  // Billing
  stripe_customer_id     String?
  billing_email          String?
  trial_ends_at          DateTime?                 @db.Timestamptz(6)
  // Metadata
  metadata               Json                      @default("{}")
  created_at             DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                  @default(now()) @db.Timestamptz(6)
  // Relations
  members                tenant_members[]
  configs                tenant_configs[]
  adapter_overrides      tenant_adapter_overrides[]
  model_overrides        tenant_model_overrides[]
  policies               tenant_policies[]
  api_keys               tenant_api_keys[]

  @@index([status])
  @@index([tier])
  @@index([domain], where: raw("(domain IS NOT NULL)"))
}

/// Tenant membership — users belong to tenants with roles
model tenant_members {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  user_id     String   // External user ID (Clerk, Auth0, etc.)
  email       String
  role        String   @default("member") // owner, admin, member, viewer, api_only
  status      String   @default("active") // active, invited, suspended
  invited_by  String?  @db.Uuid
  joined_at   DateTime? @db.Timestamptz(6)
  last_active DateTime? @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  tenant      tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, user_id])
  @@unique([tenant_id, email])
  @@index([user_id])
  @@index([email])
}

/// Tenant configuration — key-value settings per tenant
model tenant_configs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  key         String   // "default_persona", "welcome_message", "max_context_turns"
  value       String
  value_type  String   @default("string") // string, number, boolean, json
  is_secret   Boolean  @default(false)
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  tenant      tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, key])
  @@index([tenant_id])
}

/// Tenant adapter overrides — which external services each tenant uses
model tenant_adapter_overrides {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String   @db.Uuid
  adapter_type  String   // "calendar", "crm", "email", "voice", "avatar", "realtime"
  adapter_name  String   // "london_calendar", "hubspot", "salesforce", "nylas"
  is_enabled    Boolean  @default(true)
  priority      Int      @default(0) // Higher = preferred when multiple available
  config        Json     @default("{}") // Adapter-specific config (non-secret)
  credentials   Json     @default("{}") // Encrypted credentials reference
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  tenant        tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, adapter_type, adapter_name])
  @@index([tenant_id, adapter_type])
}

/// Tenant model overrides — per-tenant LLM preferences and routing
model tenant_model_overrides {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String   @db.Uuid
  intent          String   // "general", "planning", "research", "operations", "math", "judge"
  provider        String   // "anthropic", "openai", "google", "xai", "mistral", "perplexity"
  model           String   // "claude-sonnet-4-20250514", "gpt-4o", etc.
  temperature     Float    @default(0.7) @db.Real
  max_tokens      Int      @default(4096)
  is_enabled      Boolean  @default(true)
  priority        Int      @default(0) // Cascade order within intent
  fallback_model  String?  // If primary fails
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  tenant          tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, intent, provider, model])
  @@index([tenant_id, intent])
}

/// Tenant policies — approval rules, feature access, rate limits
model tenant_policies {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String   @db.Uuid
  policy_type     String   // "approval_rule", "rate_limit", "feature_access", "data_residency"
  policy_name     String   // "require_approval_for_emails", "max_api_calls_per_minute"
  is_enabled      Boolean  @default(true)
  config          Json     @default("{}") // Policy-specific configuration
  // For approval rules
  approval_threshold Float? @db.Real // Confidence below this requires approval
  approvers       String[] @default([]) // User IDs who can approve
  // For rate limits
  limit_value     Int?
  limit_period    String?  // "minute", "hour", "day", "month"
  // For feature access
  features        String[] @default([]) // Feature keys this policy controls
  // For data residency
  allowed_regions String[] @default([]) // "us", "eu", "uk", "ap"
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  tenant          tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, policy_type, policy_name])
  @@index([tenant_id, policy_type])
  @@index([is_enabled])
}

/// Tenant API keys — programmatic access tokens
model tenant_api_keys {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String    @db.Uuid
  name            String    // "Production API Key", "Staging Key"
  key_prefix      String    // First 8 chars for identification: "sk_live_"
  key_hash        String    // Hashed full key
  scopes          String[]  @default(["read", "write"]) // "read", "write", "admin", "billing"
  rate_limit      Int       @default(100) // Requests per minute
  last_used_at    DateTime? @db.Timestamptz(6)
  expires_at      DateTime? @db.Timestamptz(6)
  is_active       Boolean   @default(true)
  created_by      String    @db.Uuid // User ID who created it
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  tenant          tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([key_hash])
  @@index([tenant_id, is_active])
  @@index([key_prefix])
}

// ════════════════════════════════════════════════════════════════════════════
// CALENDAR SUBSYSTEM — Track Calendar C1 (added 2026-05-03)
// ════════════════════════════════════════════════════════════════════════════
//
// 14 models + 15 enums ported from LTM (D:\London-Tech-Map) per Track Calendar
// in BUILD_SEQUENCE.md. Adaptations applied:
//
//   - id @default(cuid()) → @default(dbgenerated("gen_random_uuid()")) @db.Uuid
//     (consistent with rest of Olivia Brain schema)
//
//   - userProfileId String + userProfile UserProfile @relation(...)
//     → userId String @db.Uuid (no FK constraint until Track F Session 18
//       wires Clerk; userId then references Clerk user IDs)
//
//   - linkedOrgId / linkedEventId / linkedPersonId fields + relations DROPPED
//     (LTM-domain FKs — Olivia Brain doesn't own Org/Event/Person; see
//     project_ltm_types_no_speculative_generalization memory)
//
//   - voiceConversations VoiceConversation[] reverse relation NOT YET ADDED
//     (lands in Track Calendar C3 when VoiceConversation model ports)
//
//   - dealRoomSessions DealRoomSession[] reverse relation DROPPED permanently
//     (DealRoom moves to real-estate spoke when that vertical builds)
//
//   - Event / EventParticipant / EventRsvp / EventSeries / PackageEvent /
//     CascadeEvent NOT PORTED (LTM tech-event modeling, separate concept
//     from personal calendar)
//
// Field naming: camelCase preserved (matches LTM) so lib/queries/calendar.ts
// ports with mechanical userProfileId → userId rename only. Diverges from
// the snake_case convention used in older Olivia Brain models above.

// ── Calendar enums ─────────────────────────────────────────────────────────

enum CalendarCategory {
  vc_meeting
  angel_meeting
  board_meeting
  advisory_call
  investor_update
  founder_meeting
  team_standup
  one_on_one
  conference_attend
  meetup_attend
  pitch_event
  demo_day_attend
  hackathon_attend
  workshop_attend
  networking_event
  gala_awards
  focus_time
  deep_work
  deal_prep
  admin_block
  email_block
  funding_deadline
  product_launch
  hiring_milestone
  legal_deadline
  weekly_review
  monthly_retrospective
  quarterly_planning
  annual_planning
  personal_event
  travel
  lunch_meeting
  coffee_chat
  ecosystem_event
  community_event
  olivia_suggestion
  synced_external
}

enum CalendarEntryType {
  meeting
  event
  time_block
  deadline
  recurring
  personal
  signal
  constraint
  block
  milestone
  ritual
}

enum CalendarPriority {
  critical
  high
  medium
  low
}

enum CalendarSyncProvider {
  google
  outlook
  calendly
  ical_url
}

enum CalendarSyncDirection {
  inbound
  outbound
  bidirectional
}

enum CalendarConflictResolution {
  pending
  local_wins
  remote_wins
  merged
  dismissed
}

enum CalendarInteractionType {
  created
  updated
  deleted
  moved
  accepted_suggestion
  dismissed_suggestion
  snoozed_suggestion
  completed_prep_task
  skipped_prep_task
  rsvp_changed
  attendance_changed
}

enum CalendarPrepTaskStatus {
  pending
  in_progress
  completed
  skipped
}

enum CalendarAttendeeRsvp {
  pending
  accepted
  declined
  tentative
}

enum CalendarAttendeeRole {
  required
  optional
  organizer
  speaker
}

enum AttendanceStatus {
  pending
  attended
  rescheduled
  missed
  cancelled
}

enum WebhookSubscriptionStatus {
  active
  expiring
  expired
  failed
  revoked
}

enum OliviaRecommendationType {
  proactive
  reactive
  scheduled
}

enum OliviaRecommendationUrgency {
  immediate
  today
  this_week
  when_relevant
}

enum OliviaRecommendationStatus {
  pending
  accepted
  dismissed
  snoozed
  expired
}

// ── Calendar models ────────────────────────────────────────────────────────

/// Personal calendar items. userId references Clerk user (post-Session 18).
/// LTM-domain FKs (linkedOrg, linkedEvent, linkedPerson) intentionally
/// dropped per project_ltm_types_no_speculative_generalization memory.
model CalendarEntry {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String                @db.Uuid
  title               String
  description         String?               @db.Text
  location            String?
  virtualUrl          String?
  startDatetime       DateTime
  endDatetime         DateTime
  allDay              Boolean               @default(false)
  entryType           CalendarEntryType     @default(event)
  category            CalendarCategory
  priority            CalendarPriority      @default(medium)
  tagsJson            Json?
  isAiGenerated       Boolean               @default(false)
  aiConfidenceScore   Decimal?              @db.Decimal(3, 2)
  aiSource            String?
  rrule               String?
  recurrenceParentId  String?               @db.Uuid
  ecosystemOrgName    String?
  investmentStage     String?
  externalCalendarId  String?
  externalProvider    CalendarSyncProvider?
  externalLastSyncAt  DateTime?
  attendanceStatus    AttendanceStatus      @default(pending)
  attendanceNote      String?               @db.Text
  rescheduledFromId   String?               @db.Uuid
  rescheduledFromDate DateTime?
  isVip               Boolean               @default(false)
  isArchived          Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  recurrenceParent   CalendarEntry?          @relation("CalendarRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren CalendarEntry[]         @relation("CalendarRecurrence")
  rescheduledFrom    CalendarEntry?          @relation("CalendarReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo      CalendarEntry[]         @relation("CalendarReschedule")
  prepTasks          CalendarPrepTask[]
  attendees          CalendarEntryAttendee[]
  interactions       CalendarInteraction[]
  reminders          CalendarReminder[]
  memoryChunks       CalendarMemoryChunk[]
  notes              CalendarNote[]

  @@index([userId, startDatetime])
  @@index([userId, isArchived])
  @@index([userId, category])
  @@index([userId, entryType])
  @@index([externalCalendarId, externalProvider])
  @@index([recurrenceParentId])
  @@index([rescheduledFromId])
  @@index([attendanceStatus])
  @@index([isArchived, startDatetime])
  @@map("calendar_entries")
}

/// Per-user calendar settings.
model CalendarPreferences {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @unique @db.Uuid
  timezone              String   @default("Europe/London")
  defaultView           String   @default("week")
  densityMode           String   @default("standard")
  workingHoursStart     Int      @default(9)
  workingHoursEnd       Int      @default(18)
  workingDaysJson       Json     @default("[1,2,3,4,5]")
  defaultEventDuration  Int      @default(60)
  briefingTime          String?
  startupStage          String?
  focusAreasJson        Json?
  oliviaEnabled         Boolean  @default(true)
  oliviaConfidenceScore Decimal  @default(0.5) @db.Decimal(3, 2)
  voiceInputEnabled     Boolean  @default(false)
  autoSendVoice         Boolean  @default(false)
  travelBufferEnabled   Boolean  @default(false)
  travelBufferMinutes   Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("calendar_preferences")
}

/// Pre-event preparation items.
model CalendarPrepTask {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calendarEntryId    String                 @db.Uuid
  title              String
  description        String?                @db.Text
  status             CalendarPrepTaskStatus @default(pending)
  priority           CalendarPriority       @default(medium)
  dueAt              DateTime?
  dueOffsetHours     Int?
  linkedDocumentType String?
  autoGenerate       Boolean                @default(false)
  completedAt        DateTime?
  isArchived         Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  calendarEntry CalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)

  @@index([calendarEntryId])
  @@index([status])
  @@index([dueAt])
  @@index([isArchived])
  @@map("calendar_prep_tasks")
}

/// Per-entry reminder settings.
model CalendarReminder {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calendarEntryId String    @db.Uuid
  reminderMinutes Int
  reminderType    String    @default("notification")
  isSent          Boolean   @default(false)
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  calendarEntry CalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)

  @@index([calendarEntryId])
  @@index([isSent])
  @@map("calendar_reminders")
}

/// People attending calendar entries. linkedPerson FK dropped (LTM-domain).
model CalendarEntryAttendee {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calendarEntryId String               @db.Uuid
  name            String
  email           String?
  phone           String?
  socialUrl       String?
  role            CalendarAttendeeRole @default(required)
  rsvpStatus      CalendarAttendeeRsvp @default(pending)
  isOrganizer     Boolean              @default(false)
  responseNote    String?
  notifiedAt      DateTime?
  respondedAt     DateTime?
  isArchived      Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  calendarEntry CalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)

  @@unique([calendarEntryId, email])
  @@index([calendarEntryId])
  @@index([rsvpStatus])
  @@index([isArchived])
  @@map("calendar_entry_attendees")
}

/// Behavior tracking for self-learning.
model CalendarInteraction {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                  @db.Uuid
  calendarEntryId String?                 @db.Uuid
  interactionType CalendarInteractionType
  metadataJson    Json?
  createdAt       DateTime                @default(now())

  calendarEntry CalendarEntry? @relation(fields: [calendarEntryId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([interactionType])
  @@index([calendarEntryId])
  @@map("calendar_interactions")
}

/// External calendar provider connections (Google, Outlook, Calendly).
/// AES-256-GCM encrypted tokens via lib/calendar/crypto.ts (ports in C2).
model CalendarSyncAccount {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                @db.Uuid
  provider          CalendarSyncProvider
  providerAccountId String
  providerEmail     String?
  accessTokenEnc    String?               @db.Text
  refreshTokenEnc   String?               @db.Text
  tokenExpiresAt    DateTime?
  syncDirection     CalendarSyncDirection @default(bidirectional)
  syncToken         String?
  lastSyncAt        DateTime?
  lastSyncError     String?               @db.Text
  consecutiveErrors Int                   @default(0)
  isActive          Boolean               @default(true)
  isArchived        Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  syncConflicts CalendarSyncConflict[]
  webhookStates CalendarWebhookState[]

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@map("calendar_sync_accounts")
}

/// Sync conflict resolution log.
model CalendarSyncConflict {
  id              String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  syncAccountId   String                     @db.Uuid
  localEntryId    String?
  externalEventId String?
  conflictType    String
  localDataJson   Json?
  remoteDataJson  Json?
  resolution      CalendarConflictResolution @default(pending)
  resolvedAt      DateTime?
  createdAt       DateTime                   @default(now())

  syncAccount CalendarSyncAccount @relation(fields: [syncAccountId], references: [id], onDelete: Cascade)

  @@index([syncAccountId])
  @@index([resolution])
  @@map("calendar_sync_conflicts")
}

/// Webhook subscription tracking. Provider expirations: Google ~7d, Outlook ~3d.
model CalendarWebhookState {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  syncAccountId         String                    @db.Uuid
  provider              CalendarSyncProvider
  subscriptionId        String
  callbackUrl           String
  eventTypesJson        Json?
  status                WebhookSubscriptionStatus @default(active)
  expiresAt             DateTime?
  renewalAttemptedAt    DateTime?
  renewedAt             DateTime?
  lastDeliveryAt        DateTime?
  lastDeliveryEventType String?
  consecutiveFailures   Int                       @default(0)
  lastFailureAt         DateTime?
  lastFailureReason     String?                   @db.Text
  providerMetaJson      Json?
  isArchived            Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  syncAccount CalendarSyncAccount @relation(fields: [syncAccountId], references: [id], onDelete: Cascade)

  @@unique([provider, subscriptionId])
  @@index([syncAccountId])
  @@index([provider, status])
  @@index([status, expiresAt])
  @@index([isArchived])
  @@map("calendar_webhook_states")
}

/// pgvector embeddings for semantic calendar search (OpenAI text-embedding-3-small, 1536 dims).
model CalendarMemoryChunk {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                       @db.Uuid
  calendarEntryId String                       @db.Uuid
  chunkIndex      Int                          @default(0)
  text            String                       @db.Text
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now())

  calendarEntry CalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)

  @@unique([calendarEntryId, chunkIndex])
  @@index([userId])
  @@index([calendarEntryId])
  @@map("calendar_memory_chunks")
}

/// AI-generated calendar suggestions from Olivia.
model OliviaCalendarRecommendation {
  id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String                      @db.Uuid
  type               OliviaRecommendationType
  urgency            OliviaRecommendationUrgency @default(when_relevant)
  status             OliviaRecommendationStatus  @default(pending)
  message            String                      @db.Text
  reasoningJson      Json?
  triggerType        String?
  triggerDescription String?
  eventDraftJson     Json?
  confidenceScore    Decimal?                    @db.Decimal(3, 2)
  actedAt            DateTime?
  dismissedAt        DateTime?
  snoozedUntil       DateTime?
  isArchived         Boolean                     @default(false)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([urgency])
  @@index([status])
  @@index([isArchived])
  @@map("olivia_calendar_recommendations")
}

/// Audit trail for voice inputs that create calendar entries.
/// calendarEntryId is polymorphic (no FK relation) — links to a CalendarEntry
/// when one was successfully created from this voice input.
model VoiceTranscriptionLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @db.Uuid
  rawTranscript    String   @db.Text
  parsedResultJson Json?
  calendarEntryId  String?  @db.Uuid
  confidenceScore  Decimal? @db.Decimal(3, 2)
  durationMs       Int?
  wasAccepted      Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@map("voice_transcription_logs")
}

/// Weekly snapshot for founder journey tracking.
model FounderWeek {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @db.Uuid
  weekStartDate        DateTime @db.Date
  meetingsCount        Int      @default(0)
  networkingCount      Int      @default(0)
  focusHours           Decimal  @default(0) @db.Decimal(5, 1)
  prepTasksCompleted   Int      @default(0)
  prepTasksTotal       Int      @default(0)
  suggestionsAccepted  Int      @default(0)
  suggestionsDismissed Int      @default(0)
  topCategoriesJson    Json?
  oliviaSummary        String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate])
  @@map("founder_weeks")
}

/// Rich notepad entries (text + drawing). The sophisticated note-taking
/// surface flagged by user 2026-05-03 — appends to calendar entries via
/// optional calendarEntryId link.
model CalendarNote {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  calendarEntryId String?  @db.Uuid
  title           String   @default("Untitled Note")
  content         String?  @db.Text
  drawingData     Json?
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  calendarEntry CalendarEntry? @relation(fields: [calendarEntryId], references: [id], onDelete: SetNull)

  @@index([userId, isArchived])
  @@index([userId, calendarEntryId])
  @@index([calendarEntryId])
  @@map("calendar_notes")
}
